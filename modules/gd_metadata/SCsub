# modules/gd_metadata/SCsub
Import("env")

env_metadata = env.Clone()

env_metadata.Append(CCFLAGS=["-fexceptions"])
env_metadata.Append(CXXFLAGS=["-fexceptions"])

# Use C++17
env_metadata.Append(CXXFLAGS=["-std=c++17"])

env_metadata.Append(CPPDEFINES=["TAGLIB_STATIC", "TAGLIB_EXPORT="])

# Include TagLib headers — include both taglib and its internal dirs
env_metadata.Append(CPPPATH=[
    "#modules/gd_metadata/third_party/taglib",
    "#modules/gd_metadata/third_party/taglib/taglib",
    "#modules/gd_metadata/third_party/taglib/taglib/toolkit",
    "#modules/gd_metadata/third_party/taglib/taglib/ape",
    "#modules/gd_metadata/third_party/taglib/taglib/asf",
    "#modules/gd_metadata/third_party/taglib/taglib/flac",
    "#modules/gd_metadata/third_party/taglib/taglib/mpc",
    "#modules/gd_metadata/third_party/taglib/taglib/mp4",
    "#modules/gd_metadata/third_party/taglib/taglib/mpeg",
    "#modules/gd_metadata/third_party/taglib/taglib/mpeg/id3v1",
    "#modules/gd_metadata/third_party/taglib/taglib/mpeg/id3v2",
    "#modules/gd_metadata/third_party/taglib/taglib/ogg",
    "#modules/gd_metadata/third_party/taglib/taglib/ogg/flac",
    "#modules/gd_metadata/third_party/taglib/taglib/ogg/opus",
    "#modules/gd_metadata/third_party/taglib/taglib/ogg/speex",
    "#modules/gd_metadata/third_party/taglib/taglib/ogg/vorbis",
    "#modules/gd_metadata/third_party/taglib/taglib/wavpack",
    "#modules/gd_metadata/third_party/taglib/3rdparty",
	"#modules/gd_metadata/third_party/taglib/3rdparty/utfcpp",
	"#modules/gd_metadata/third_party/taglib/3rdparty/utfcpp/utf8",
	"#modules/gd_metadata/third_party/taglib/taglib/riff/",
	"#modules/gd_metadata/third_party/taglib/taglib/riff/wav",
	"#modules/gd_metadata/third_party/taglib/taglib/riff/aiff"
])

# Collect sources (note: correct folder name is third_party)
taglib_sources = []

taglib_sources += env_metadata.Glob("third_party/taglib/taglib/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/toolkit/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/mpeg/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ogg/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ogg/flac/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ogg/opus/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ogg/speex/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ogg/vorbis/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/flac/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/mp4/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/asf/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/mpc/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/ape/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/wavpack/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/mpeg/id3v1/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/mpeg/id3v2/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib//mpeg/id3v2/frames/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/riff/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/riff/wav/*.cpp")
taglib_sources += env_metadata.Glob("third_party/taglib/taglib/riff/aiff/*.cpp")

module_sources = env_metadata.Glob("*.cpp")

# Add TagLib and module sources
env_metadata.add_source_files(env.modules_sources, taglib_sources + module_sources)

# Register module initialization
env_metadata.Append(MODULE_INITIALIZATION_FUNCTIONS=["gd_metadata"])