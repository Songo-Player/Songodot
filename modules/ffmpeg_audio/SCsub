Import("env")
import os

module_dir = Dir(".").abspath
ffmpeg_path = os.path.join(module_dir, "thirdparty", "ffmpeg")
ffmpeg_lib_dir = os.path.join(ffmpeg_path, "lib")

env.Append(CPPPATH=[os.path.join(ffmpeg_path, "include")])

if env["platform"] == "windows":
    env.Append(LIBPATH=[ffmpeg_lib_dir])
    env.Append(LIBS=["avcodec", "avformat", "avutil", "swresample"])
elif env["platform"] == "linuxbsd":
    env.ParseConfig( "pkg-config --cflags --libs libavformat libavcodec libavutil libswresample" )

sources = [
    "register_types.cpp",
    "ffmpeg_audio.cpp",
]

env.add_source_files(env.modules_sources, sources)