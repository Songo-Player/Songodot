#!/usr/bin/env python

Import("env")
Import("env_modules")

env_songo = env_modules.Clone()

# bgplayer/ holds the engine's public headers and the wire protocol, copied
# from SongoBGPlayer. The engine itself is loaded at runtime (engine_library.h).
env_songo.Prepend(CPPPATH=["#modules/songo_player_harness", "#modules/songo_player_harness/bgplayer"])

module_obj = []
sources = Glob("*.cpp")
if env["platform"] == "windows":
    # No songo_bgplayer on Windows, so no daemon transport
    sources = [s for s in sources if s.name != "transport_daemon.cpp"]
env_songo.add_source_files(module_obj, sources)
env_songo.add_source_files(module_obj, "bgplayer/*.cpp")
env.modules_sources += module_obj
