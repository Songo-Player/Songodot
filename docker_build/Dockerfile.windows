# Cross compiles the Songodot Windows (x86_64) export template with MinGW-w64
# on a Linux host. docker_build/build_windows.sh builds and runs this.
#
# Same toolchain as SongoBGPlayer's Windows engine build (Ubuntu 24.04's
# MinGW-w64 GCC, posix threads), so the module and the engine DLL it loads
# agree on things like std::chrono's steady clock.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-mingw-w64-x86-64-posix \
        g++-mingw-w64-x86-64-posix \
        binutils-mingw-w64-x86-64 \
        python3 \
        scons \
        rsync \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
    && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix

COPY build_in_container.sh /usr/local/bin/build_in_container.sh

ENV SONGODOT_PROFILE=windows_profile.py
# The template itself, not its .console.exe wrapper (only debug exports use it)
ENV SONGODOT_BIN_GLOB="bin/godot.windows.template_*.x86_64.exe"
ENTRYPOINT ["/usr/local/bin/build_in_container.sh"]
